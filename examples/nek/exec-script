#!/bin/bash

# Unified run script for mini_channel demo.
# This mirrors the flow in drl_repo_TEST/execs/run-script:
#   1) initialize run folder
#   2) read nproc + run path
#   3) mpirun: rank0 python + ranks>0 nek5000

#-- Load environment (optional) --
# If you need custom environments, uncomment and adjust the lines below.
# source ~/.bashrc.miniforge
# source ~/.bashrc.openmpi_ucx
# source /home/firedrake/firedrake/bin/activate

source /workspace/test/load-module
ml list 
source /workspace/env/bin/activate

echo "Environment activated"
echo "Python version: $(python --version)"
echo "MPI version: $(mpirun --version)"
echo "MPI4PY version: $(python -c 'import mpi4py; print(mpi4py.__version__)')"
echo "Nek version: $(nek5000 --version)"
echo "Nek version: $(nek5000 --version)"

# -- OPENMPI UCX SETUP --
unset OMPI_MCA_pml OMPI_MCA_osc UCX_TLS UCX_NET_DEVICES
export HWLOC_HIDE_ERRORS=1
export UCX_TLS=sm,self,tcp,cma,sysv,posix
export OMPI_MCA_btl=self,vader,tcp
export OMPI_ALLOW_RUN_AS_ROOT=1
export OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1


# -- LOG SETUP --
LOG_DIR="log-files"
mkdir -p ${LOG_DIR}

# -- SCRIPT DIR SETUP --
SCRIPT_DIR=$(pwd)

# -- Default values --
CONFIG_NAME="MC-OC.yml" # No DRL control, just evaluation
MODE="eval"
STEPS=""
NENVS=6
FLAG_COMPILE=0
SCRIPT_NAME="run-transient.py"
while [[ $# -gt 1 ]]; do
    case "$1" in
        --config)
            CONFIG_NAME="$2"
            shift 2
            ;;
        --steps)
            STEPS="$2"
            shift 2
            ;;
        --script)
            SCRIPT_NAME="$2"
            shift 2
            ;;
        --mode)
            MODE="$2"
            shift 2
            ;;
        --nenvs)
            NENVS="$2"
            shift 2
            ;;
    esac
    # Make --compile flag optional
    if [[ "$1" == "--compile" ]]; then
        FLAG_COMPILE=1
        shift 1
    fi
    # Help message
    if [[ "$1" == "--help" ]]; then
        echo "Usage: $0 [--config CONFIG_NAME] [--steps STEPS] [--compile] [--script SCRIPT_NAME] [--mode MODE] [--nenvs NENVS]"
        echo "  --config CONFIG_NAME: Configuration file name"
        echo "  --steps STEPS: Number of steps"
        echo "  --compile: Compile the case"
        echo "  --script SCRIPT_NAME: Script name"
        echo "  --mode MODE: Mode of the simulation"
        echo "  --nenvs NENVS: Number of environments"
        exit 0
    fi
done

echo "FLAG_COMPILE: ${FLAG_COMPILE}"
# -- Initialize run folder --
CONFIG_PATH="${SCRIPT_DIR}/conf/${CONFIG_NAME}"

# -- Compile the case (only when --compile is passed) --
if [[ "${FLAG_COMPILE}" == 1 ]]; then
    COMPILE_PATH=$(grep -ri 'compile_path' "${CONFIG_PATH}" | awk -F':' '{gsub(/ /,"",$2); print $2}')
    COMPILE_PATH=$(echo "${COMPILE_PATH}" | sed 's/"//g')
    if [[ "${COMPILE_PATH}" != /* ]]; then
        COMPILE_PATH="${SCRIPT_DIR}/${COMPILE_PATH}"
    fi
    echo "COMPILE_PATH: ${COMPILE_PATH}"
    if [[ ! -d "${COMPILE_PATH}" ]]; then
        echo "Error: compile_path does not exist: ${COMPILE_PATH}"
        exit 1
    fi
    cd "${COMPILE_PATH}"
    bash compile_script --clean
    bash compile_script --all
    echo "Compiled the case."
    cd "${SCRIPT_DIR}" # Go back to the script directory.
fi

# -- Initialize run folder --
initialize_run_folder() {
    local overrides=("$@")
    # Build command with optional overrides (nek_initial.py accepts overrides as positional arguments)
    INIT_CMD=("${SCRIPT_DIR}/nek_initial.py" --config "${CONFIG_PATH}")
    if [[ ${#overrides[@]} -gt 0 ]]; then
        INIT_CMD+=("${overrides[@]}")
    fi
    mpirun --allow-run-as-root -n 1 python3 "${INIT_CMD[@]}" \
      > "${LOG_DIR}/log.initial.${CONFIG_NAME}" 2>&1

    # -- Tracking the run folder --
    AGENT_RUN_NAME=$(grep -ri 'agent_run_name' "${CONFIG_PATH}" | awk -F':' '{gsub(/ /,"",$2); print $2}')
    NTOT=$(grep -ri 'nproc' "${CONFIG_PATH}" | awk -F':' '{gsub(/ /,"",$2); print $2}')
    DIR_FILES_PATH="dir-files/RUN_PATH_${AGENT_RUN_NAME}.txt"

    if [[ ! -f "${DIR_FILES_PATH}" ]]; then
        echo "Error: dir-files/RUN_PATH_${AGENT_RUN_NAME}.txt does not exist"
        exit 1
    fi
    RUN_PATH=$(head -n 1 "${DIR_FILES_PATH}")
    RUN_ROOT=$(dirname "${DIR_FILES_PATH}")
    RUN_NAME=$(basename "${DIR_FILES_PATH}")
    echo "CONFIG: ${CONFIG_NAME}, NTOT: ${NTOT}, RUN_ROOT: ${RUN_ROOT}, RUN_NAME: ${RUN_NAME}"
}

# -- Run the script --
if [[ "${MODE}" == "run" ]]; then

    initialize_run_folder
    STEP_ARGS=()
    if [[ -n "${STEPS}" ]]; then
        STEP_ARGS=(--steps "${STEPS}")
    fi
    mpirun --allow-run-as-root -n 1 python3 "${SCRIPT_DIR}/${SCRIPT_NAME}" --config "${CONFIG_PATH}" "${STEP_ARGS[@]}" :\
            -n "${NTOT}" bash -c "cd ${RUN_PATH} && ./nek5000" 

elif [[ "${MODE}" == "eval" ]]; then

    for ((ienv=1; ienv<=NENVS; ienv++)); do
        # Build eval-specific overrides
        EVAL_OVERRIDES=("runner.rank=${ienv}" "runner.evaluation=True")
        # Pass overrides to initialize_run_folder
        initialize_run_folder "${EVAL_OVERRIDES[@]}"
        STEP_ARGS=()
        if [[ -n "${STEPS}" ]]; then
            STEP_ARGS=(--steps "${STEPS}")
        fi
        mpirun --allow-run-as-root -n 1 python3 "${SCRIPT_DIR}/${SCRIPT_NAME}" --config "${CONFIG_PATH}" \
            "${STEP_ARGS[@]}" \
            --overrides "runner.rank=${ienv}" "runner.evaluation=True" \
            :\
            -n "${NTOT}" bash -c "cd ${RUN_PATH} && ./nek5000" > "${LOG_DIR}/log.eval.${CONFIG_NAME}.${ienv}.txt" 2>&1
    done
fi