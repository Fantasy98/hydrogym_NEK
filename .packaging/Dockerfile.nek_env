# Dockerfile for a NEK-MARL environment.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# ----------------------------------------------------------------------
# Base system packages needed for UCX/OpenMPI builds and Nek
# ----------------------------------------------------------------------
RUN apt-get update \
    && apt-get -y dist-upgrade \
    && apt-get install -y --no-install-recommends \
        build-essential \
        gfortran \
        gcc \
        g++ \
        make \
        autoconf \
        automake \
        libtool \
        pkg-config \
        git \
        wget \
        ca-certificates \
        curl \
        openssh-client \
        tzdata \
        python3 \
        python3-dev \
        python3-venv \
        python3-pip \
        zlib1g-dev \
        libopenblas-serial-dev \
        libcurl4-openssl-dev \
        libxml2-dev \
        bison \
        flex \
    && rm -rf /var/lib/apt/lists/*

# ----------------------------------------------------------------------
# UCX + OpenMPI installation (following install_mpi.sh)
# ----------------------------------------------------------------------
ENV MPI_BASE=/opt/ucx_mpi
ENV UCX_INSTALL=${MPI_BASE}/ucx_local \
    OPENMPI_VERSION=4.1.4 \
    OPENMPI_INSTALL=${MPI_BASE}/openmpi-4.1.4-ucx

RUN set -euo pipefail \
    && mkdir -p "${MPI_BASE}" \
    && cd "${MPI_BASE}" \
    # UCX
    && git clone https://github.com/openucx/ucx.git \
    && cd ucx \
    && mkdir -p "${UCX_INSTALL}" \
    && UCX_INSTALL_ABS="${UCX_INSTALL}" \
    && ./autogen.sh \
    && ./contrib/configure-release --prefix="${UCX_INSTALL_ABS}" --enable-mt \
    && make -j"$(nproc)" \
    && make install \
    && cd "${MPI_BASE}" \
    # OpenMPI
    && wget "https://download.open-mpi.org/release/open-mpi/v4.1/openmpi-${OPENMPI_VERSION}.tar.gz" \
    && tar -xzf "openmpi-${OPENMPI_VERSION}.tar.gz" \
    && cd "openmpi-${OPENMPI_VERSION}" \
    && UCX_PATH="${UCX_INSTALL}" \
    && OPENMPI_INSTALL_ABS="${OPENMPI_INSTALL}" \
    && ./configure --prefix="${OPENMPI_INSTALL_ABS}" \
                   --with-ucx="${UCX_PATH}" \
                   --without-gpfs \
                   CC=gcc CXX=g++ FC=gfortran \
    && make -j"$(nproc)" \
    && make install \
    && cd "${MPI_BASE}" \
    && rm -f "openmpi-${OPENMPI_VERSION}.tar.gz"

ENV MPI_UCX_ROOT=${MPI_BASE} \
    UCX_ROOT=${UCX_INSTALL} \
    OPENMPI_ROOT=${OPENMPI_INSTALL} \
    OPAL_PREFIX=${OPENMPI_INSTALL} \
    PATH=${OPENMPI_INSTALL}/bin:${UCX_INSTALL}/bin:${PATH} \
    LD_LIBRARY_PATH=${OPENMPI_INSTALL}/lib:${UCX_INSTALL}/lib:${LD_LIBRARY_PATH}

# ----------------------------------------------------------------------
# Miniforge + Python environment for Nek
# (following install_miniforge.sh and install_auto_env.sh)
# ----------------------------------------------------------------------
ENV MINIFORGE_INSTALL=/opt/miniforge3 \
    CONDA_ENV=nek

RUN set -euo pipefail \
    && arch="$(uname -m)" \
    && if [ "${arch}" = "x86_64" ]; then \
         MINIFORGE_ARCH="Linux-x86_64"; \
       elif [ "${arch}" = "aarch64" ] || [ "${arch}" = "arm64" ]; then \
         MINIFORGE_ARCH="Linux-aarch64"; \
       else \
         echo "Unsupported architecture: ${arch}" >&2; exit 1; \
       fi \
    && curl -fsSL "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-${MINIFORGE_ARCH}.sh" -o /tmp/miniforge.sh \
    && bash /tmp/miniforge.sh -b -p "${MINIFORGE_INSTALL}" \
    && rm /tmp/miniforge.sh \
    && "${MINIFORGE_INSTALL}/bin/conda" create --name "${CONDA_ENV}" python=3.8 -y \
    # Follow utils/install_auto_env.sh package order
    && "${MINIFORGE_INSTALL}/bin/conda" run -n "${CONDA_ENV}" python -m pip install pip==22.3.1 \
    && "${MINIFORGE_INSTALL}/bin/conda" run -n "${CONDA_ENV}" python -m pip install setuptools==59.5.0 \
    && "${MINIFORGE_INSTALL}/bin/conda" run -n "${CONDA_ENV}" python -m pip install mpi4py==3.1.4 --no-cache-dir \
    && "${MINIFORGE_INSTALL}/bin/conda" run -n "${CONDA_ENV}" python -m pip install stable-baselines3==1.7.0 --no-cache-dir \
    && "${MINIFORGE_INSTALL}/bin/conda" run -n "${CONDA_ENV}" python -m pip install pettingzoo==1.19.0 \
    && "${MINIFORGE_INSTALL}/bin/conda" run -n "${CONDA_ENV}" python -m pip install supersuit==3.5.0 \
    && "${MINIFORGE_INSTALL}/bin/conda" run -n "${CONDA_ENV}" python -m pip install gym==0.24.1 \
    && "${MINIFORGE_INSTALL}/bin/conda" run -n "${CONDA_ENV}" python -m pip install omegaconf==2.1.0 \
    && "${MINIFORGE_INSTALL}/bin/conda" run -n "${CONDA_ENV}" python -m pip install scipy \
    && "${MINIFORGE_INSTALL}/bin/conda" run -n "${CONDA_ENV}" python -m pip install matplotlib \
    && "${MINIFORGE_INSTALL}/bin/conda" run -n "${CONDA_ENV}" python -m pip install numpy==1.22.4 \
    && "${MINIFORGE_INSTALL}/bin/conda" run -n "${CONDA_ENV}" python -m pip install tensorboard \
    && "${MINIFORGE_INSTALL}/bin/conda" run -n "${CONDA_ENV}" python -m pip install pandas \
    && "${MINIFORGE_INSTALL}/bin/conda" run -n "${CONDA_ENV}" python -m pip install pyyaml \
    && "${MINIFORGE_INSTALL}/bin/conda" run -n "${CONDA_ENV}" python -m pip install psutil \
    && "${MINIFORGE_INSTALL}/bin/conda" clean -afy

# ----------------------------------------------------------------------
# Patch Supersuit's vec_env_args (following utils/patch_supersuit.py)
# ----------------------------------------------------------------------
RUN set -euo pipefail \
    && "${MINIFORGE_INSTALL}/bin/conda" run -n "${CONDA_ENV}" python - << 'EOF'
import os
import shutil
from pathlib import Path

import supersuit


def find_supersuit_path():
    return os.path.dirname(supersuit.__file__)


def backup_original_file(file_path: str):
    backup_path = file_path + ".backup"
    if not os.path.exists(backup_path):
        shutil.copy2(file_path, backup_path)
        print(f"Created backup: {backup_path}")
    else:
        print(f"Backup already exists: {backup_path}")


def patch_vec_env_args(file_path: str):
    with open(file_path, "r") as f:
        content = f.read()

    original_function = """def vec_env_args(env, num_envs):
    def env_fn():
        env_copy = cloudpickle.loads(cloudpickle.dumps(env))
        return env_copy

    return [env_fn] * num_envs, env.observation_space, env.action_space"""

    patched_function = """def vec_env_args(env, num_envs):
    if num_envs == 1:
        def env_fn():
            env_copy = env
            return env_copy
    else: 
        def env_fn():
            env_copy = cloudpickle.loads(cloudpickle.dumps(env))
            return env_copy

    return [env_fn] * num_envs, env.observation_space, env.action_space"""

    if patched_function in content:
        print("Supersuit patch already applied.")
        return

    if original_function not in content:
        raise SystemExit("Original vec_env_args function not found; file may have changed.")

    new_content = content.replace(original_function, patched_function)
    with open(file_path, "w") as f:
        f.write(new_content)

    print("Supersuit vec_env_args patched successfully.")


supersuit_path = find_supersuit_path()
target_file = os.path.join(supersuit_path, "vector", "vector_constructors.py")

if not os.path.exists(target_file):
    raise SystemExit(f"Supersuit vector_constructors.py not found at: {target_file}")

print(f"Supersuit path: {supersuit_path}")
print(f"Target file: {target_file}")

backup_original_file(target_file)
patch_vec_env_args(target_file)
EOF

# ----------------------------------------------------------------------
# Make Conda available by default in interactive shells
# ----------------------------------------------------------------------
RUN echo "source ${MINIFORGE_INSTALL}/etc/profile.d/conda.sh" >> /root/.bashrc \
    && echo "conda activate ${CONDA_ENV}" >> /root/.bashrc

ENV PATH=${MINIFORGE_INSTALL}/bin:${PATH}

# Default working directory
WORKDIR /workspace