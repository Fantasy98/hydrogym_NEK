# Dockerfile for a MPI environment for HydroGym
FROM ubuntu:22.04
USER root
# Get the latest updates and remove the apt lists.
RUN apt-get update && apt-get install -y \
    wget \
    git \
    build-essential \
    gfortran \
    autoconf \
    automake \
    libtool \
    pkg-config \
    m4 \
    flex \
    bison \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

USER firedrake
WORKDIR /home/firedrake

ENV OPENMPI_VERSION=4.1.4
ENV MPI_UCX_ROOT=/home/firedrake/ucx_mpi
ENV UCX_INSTALL=/home/firedrake/ucx_mpi/ucx/ucx_local
ENV OPENMPI_INSTALL=/home/firedrake/ucx_mpi/openmpi-${OPENMPI_VERSION}-ucx
ENV MPI_UCX_ENV=/home/firedrake/.bashrc.openmpi_ucx
ENV OMPI_ALLOW_RUN_AS_ROOT=1
ENV OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1

RUN set -eux; \
    mkdir -p "$MPI_UCX_ROOT"; \
    cd "$MPI_UCX_ROOT"; \
    rm -rf ucx; \
    git clone https://github.com/openucx/ucx.git; \
    cd ucx; \
    mkdir -p "$UCX_INSTALL"; \
    ./autogen.sh; \
    ./contrib/configure-release --prefix="$UCX_INSTALL" --enable-mt; \
    make -j"$(nproc)"; \
    make install

RUN set -eux; \
    cd "$MPI_UCX_ROOT"; \
    if [ ! -f "openmpi-${OPENMPI_VERSION}.tar.gz" ]; then \
        wget "https://download.open-mpi.org/release/open-mpi/v4.1/openmpi-${OPENMPI_VERSION}.tar.gz"; \
    fi; \
    tar -xzvf "openmpi-${OPENMPI_VERSION}.tar.gz"; \
    cd "openmpi-${OPENMPI_VERSION}"; \
    ./configure --prefix="$OPENMPI_INSTALL" --with-ucx="$UCX_INSTALL" --without-gpfs CC=gcc CXX=g++ FC=gfortran; \
    make -j"$(nproc)"; \
    make install

RUN cat > "$MPI_UCX_ENV" << EOF
OpenMPI + UCX Environment Configuration
Generated on container build
Do not edit manually - this file is auto-generated

export MPI_UCX_ROOT="/home/firedrake/ucx_mpi"
export UCX_ROOT="/home/firedrake/ucx_mpi/ucx/ucx_local"
export OPENMPI_ROOT="/home/firedrake/ucx_mpi/openmpi-${OPENMPI_VERSION}-ucx"

export PATH="/home/firedrake/ucx_mpi/openmpi-${OPENMPI_VERSION}-ucx/bin:\$PATH"
export PATH="/home/firedrake/ucx_mpi/ucx/ucx_local/bin:\$PATH"
export LD_LIBRARY_PATH="/home/firedrake/ucx_mpi/openmpi-${OPENMPI_VERSION}-ucx/lib:/home/firedrake/ucx_mpi/ucx/ucx_local/lib:\$LD_LIBRARY_PATH"
export OPAL_PREFIX="/home/firedrake/ucx_mpi/openmpi-${OPENMPI_VERSION}-ucx"
export UCX_NET_DEVICES=all
export UCX_TLS=rc,sm,ud,self
export OMP_NUM_THREADS=1
EOF
